# Allow source and repository metadata explicitly.
/*
!/.gitignore
!/README.md
!/app/
!/collector/
!/work/

/app/*
!/app/*.cmd
!/app/*.mjs
!/app/*.ps1
!/app/package.json
!/app/lib/
!/app/test/
!/app/web/
!/app/data/

/app/data/*
!/app/data/licenses/
/app/data/licenses/*
!/app/data/licenses/gaku-navi-MIT.txt

/app/lib/**
!/app/lib/**/
!/app/lib/**/*.mjs
!/app/lib/**/*.js
!/app/lib/vendor/manifest.json
!/app/lib/vendor/LICENSE-gakumas-tools.txt
!/app/lib/vendor/js-yaml/LICENSE

/app/test/**
!/app/test/**/
!/app/test/**/*.mjs
/app/test/live-artwork.test.mjs
/app/test/hif-ability-account-audit.test.mjs
/app/test/recommend-memory-search.test.mjs

/app/web/*
!/app/web/*.html
!/app/web/*.js
!/app/web/*.css

/collector/*
!/collector/*.c
!/collector/*.h
!/collector/*.def
!/collector/README.md
!/collector/tests/
/collector/tests/*
!/collector/tests/*.c
!/collector/tests/*.mjs
!/collector/tests/*.py
!/collector/tests/README.md

/work/*
!/work/build_collector.cmd
!/work/build_collector.py
!/work/build_collector_fixtures.cmd
!/work/build_thread_stack_test.cmd

**/node_modules/
**/__pycache__/
